# ─────────────────────────────────────────────────────────────
#  Réza — configuration Microsoft 365
#  Copiez ce fichier en `.env.local` puis renseignez les valeurs.
#  Sans VITE_AZURE_CLIENT_ID, l'application démarre en MODE DÉMO.
# ─────────────────────────────────────────────────────────────

# ID d'application (client) de l'inscription Entra ID (type SPA)
VITE_AZURE_CLIENT_ID=

# ID du locataire (tenant) Microsoft 365 de la société
VITE_AZURE_TENANT_ID=

# Nom affiché dans l'application
VITE_APP_NAME=Réza
VITE_COMPANY_NAME=AlgonisR

# Plage horaire affichée dans le planning (heures pleines)
VITE_DAY_START_HOUR=7
VITE_DAY_END_HOUR=20

# ── Packaging Teams / Outlook (npm run teams:package) ──
# URL publique HTTPS où l'application est déployée (sans / final)
APP_PUBLIC_URL=https://reservations.contoso.com
# GUID unique de l'application Teams (générez-en un : npx uuid)
TEAMS_APP_ID=
